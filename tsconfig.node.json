{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "composite": true,
    "types": ["node", "electron-vite/node"]
  },
  "include": [
    "electron.vite.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/database/**/*",
    "src/domain/**/*",
    "src/shared/**/*",
    "src/services/**/*",
    "src/import/**/*",
    "src/game-data/**/*",
    "src/game-data/**/*.json"
  ]
}
